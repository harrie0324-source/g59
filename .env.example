# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app (they are not secrets).

# Supabase project (Settings → API). The publishable/anon key is safe to ship.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Development only: lets food search call USDA directly before the Edge Function is deployed.
# Get a free key at https://fdc.nal.usda.gov/api-key-signup. Ignored in production builds.
EXPO_PUBLIC_USDA_DEV_KEY=
